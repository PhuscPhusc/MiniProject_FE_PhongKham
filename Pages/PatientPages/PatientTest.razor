@page "/patient-tests"

@inject BenhNhanService benhNhanService;

@inject NavigationManager navigationManager;



@implements IDisposable



<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar Patient (màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #007bff, #0056b3);">
        <HeaderPatient />
    </div>

    <!-- Navbar Patient (màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarPatient />
    </div>

    <!-- Nội dung chính: Kết quả xét nghiệm -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">
                🧪 Lịch sử xét nghiệm
            </h2>

            <EditForm Model="new ThongTinKetQuaXetNghiemBenhNhanViewModel()" OnValidSubmit="HandleValidSearch"
                      class="frm-search input-group mb-3">
                <input type="text" class="form-control" placeholder="Search by patient id..." @bind="@id" />
                <NavLink href=@($"/patient-tests?id={id}") class="btn btn-warning" type="submit">Search</NavLink>
            </EditForm>

            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <table class="table table-hover align-middle">
                        <thead class="table-primary text-center">
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Mã sổ khám bệnh</th>
                                <th scope="col">Họ tên bệnh nhân</th>
                                <th scope="col">Mã lần khám</th>
                                <th scope="col">Mã danh mục</th>
                                <th scope="col">Tên danh mục xét nghiệm</th>
                                <th scope="col">Giá tại thời điểm</th>
                                <th scope="col">Ngày thực hiện</th>
                                <th scope="col">Kết quả</th>
                                <th scope="col">Bác sĩ chỉ định</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ThongTinKetQuaXetNghiemBenhNhanViewModel item in benhNhanService._ketQuaXetNghiem)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@item.Id</td>
                                    <td>@item.MaSoKhamBenh</td>
                                    <td>@item.HoTenBenhNhan</td>
                                    <td>@item.MaLanKham</td>
                                    <td>@item.MaDanhMucXetNghiem</td>
                                    <td>@item.TenDanhMucXetNghiem</td>
                                    <td>@item.GiaTaiThoiDiem.ToString("N0") đ</td>
                                    <td>@item.NgayThucHien.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-info text-dark">@item.KetQuaXetNghiem</span></td>
                                    <td><i class="bi bi-person-badge"></i> @item.TenBacSiChiDinh</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>



@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int id { get; set; }

    public async Task HandleValidSearch()
    {
        navigationManager.NavigateTo($"/patient-tests?id={id}");
    }

    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        benhNhanService.Onchange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await benhNhanService.GetKetQuaXetNghiem(id);
    }

    public void Dispose()
    {
        // Cleanup nếu cần
        benhNhanService.Onchange -= StateHasChanged;
    }
}