@page "/reception-patients-register"

@inject LeTanService leTanService;

@inject NavigationManager navigationManager;

@implements IDisposable

<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar (chỉ hiện khi màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #0279f8, #0056b3); ">
        <HeaderReception />
    </div>

    <!-- Navbar ngang (chỉ hiện khi màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarReception />
    </div>

    <!-- Nội dung chính: Edit User -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">✏️ Thêm bệnh nhân</h2>
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <EditForm Model="@benhNhanMoi" OnValidSubmit="AddUser">
                        <DataAnnotationsValidator />
                        @* <ValidationSummary /> *@

                        <div class="mb-3">
                            <label class="form-label">Id</label>
                            <InputNumber class="form-control" @bind-Value="benhNhanMoi.Id" />
                            <ValidationMessage For="@(() => benhNhanMoi.Id)" class="text-danger"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Họ Tên</label>
                            <InputText class="form-control" @bind-Value="benhNhanMoi.HoTen" />
                            <ValidationMessage For="@(() => benhNhanMoi.HoTen)" class="text-danger"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ngày Sinh</label>
                            <InputDate class="form-control" @bind-Value="benhNhanMoi.NgaySinh" />
                            <ValidationMessage For="@(() => benhNhanMoi.NgaySinh)" class="text-danger"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Giới Tính</label>
                            <InputText class="form-control" @bind-Value="benhNhanMoi.GioiTinh" />
                            <ValidationMessage For="@(() => benhNhanMoi.GioiTinh)" class="text-danger"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <InputText class="form-control" @bind-Value="benhNhanMoi.SDT" />
                            <ValidationMessage For="@(() => benhNhanMoi.SDT)" class="text-danger"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="benhNhanMoi.Email" />
                            <ValidationMessage For="@(() => benhNhanMoi.Email)" class="text-danger"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật Khẩu</label>
                            <InputText class="form-control" @bind-Value="benhNhanMoi.MatKhauHash" />
                            <ValidationMessage For="@(() => benhNhanMoi.MatKhauHash)" class="text-danger"/>
                        </div>


                        <button type="submit" class="btn btn-primary">Thêm bệnh nhân</button>
                        <NavLink href="/reception-patients-search" class="btn btn-secondary ms-2">Hủy/Thoát</NavLink>

                        @if (thongBao != "")
                        {
                            <div class="alert alert-danger">
                                @thongBao
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>





@code {
    private string thongBao = "";
    private LeTanAddBenhNhanViewModel benhNhanMoi = new LeTanAddBenhNhanViewModel();
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        leTanService.Onchange += StateHasChanged;
    }

    private async Task AddUser()
    {
        var result = await leTanService.PostBenhNhan(benhNhanMoi);
        if (result)
        {
            thongBao = "Thêm người dùng thành công";
            benhNhanMoi = new LeTanAddBenhNhanViewModel(); // reset form
        }
        else
        {
            thongBao = "Thêm người dùng thất bại";
        }

    }

    
    public void Dispose()
    {
        // Cleanup nếu cần
        leTanService.Onchange -= StateHasChanged;
    }
}