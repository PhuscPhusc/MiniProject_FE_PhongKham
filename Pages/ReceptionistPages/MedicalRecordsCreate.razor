@page "/reception-medical-records-create"

@inject LeTanService leTanService;


@implements IDisposable


<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar Reception (màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #007bff, #0056b3);">
        <HeaderReception />
    </div>

    <!-- Navbar Reception (màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarReception />
    </div>

    <!-- Nội dung chính: Tạo sổ khám bệnh -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">✏️ Tạo sổ khám bệnh mới</h2>
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <EditForm Model="@soKhamMoi" OnValidSubmit="AddSoKhamBenh">
                        <DataAnnotationsValidator />
                        @* <ValidationSummary class="text-danger" /> *@

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Mã sổ khám bệnh</label>
                                <InputNumber class="form-control" @bind-Value="soKhamMoi.Id" />
                                <ValidationMessage For="@(() => soKhamMoi.Id)" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Mã bệnh nhân</label>
                                <InputNumber class="form-control" @bind-Value="soKhamMoi.BenhNhanId" />
                                <ValidationMessage For="@(() => soKhamMoi.BenhNhanId)" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ngày tạo</label>
                                <InputDate class="form-control" @bind-Value="soKhamMoi.NgayTao" />
                                <ValidationMessage For="@(() => soKhamMoi.NgayTao)" class="text-danger" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Ghi chú</label>
                                <InputTextArea class="form-control" @bind-Value="soKhamMoi.GhiChu" Rows="3" />
                                <ValidationMessage For="@(() => soKhamMoi.GhiChu)" class="text-danger" />
                            </div>

                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-primary">Tạo sổ khám bệnh</button>
                            </div>
                        </div>
                        @if (thongBao != "")
                        {
                            <div class="alert alert-danger">
                                @thongBao
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>


</div>




@code {
    private string thongBao = "";

    private LeTanAddSoKhamBenhViewModel soKhamMoi = new LeTanAddSoKhamBenhViewModel();

    
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        leTanService.Onchange += StateHasChanged;
    }

    private async Task AddSoKhamBenh()
    {
        var result = await leTanService.PostSoKhamBenh(soKhamMoi);
        if (result.Success)
        {
            thongBao = result.Message;
            soKhamMoi = new LeTanAddSoKhamBenhViewModel(); // reset form
        }
        else
        {
            thongBao = result.Message; // hiển thị lỗi từ API
        }
    }


    public void Dispose()
    {
        // Cleanup nếu cần
        leTanService.Onchange -= StateHasChanged;
    }
}


