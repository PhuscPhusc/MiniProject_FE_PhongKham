@page "/add-new-role"

@inject AdminService adminService;

@inject NavigationManager navigationManager;

@implements IDisposable

<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar (chỉ hiện khi màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #0279f8, #0056b3); ">
        <HeaderAdmin />
    </div>

    <!-- Navbar ngang (chỉ hiện khi màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarAdmin />
    </div>

    <!-- Nội dung chính: Edit User -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">✏️ Chỉnh sửa người dùng</h2>
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <EditForm Model="@newRole" OnValidSubmit="addNewRole">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Id </label>
                            <InputNumber class="form-control" @bind-Value="newRole.Id" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tên Role</label>
                            <InputText class="form-control" @bind-Value="newRole.TenRole" />
                        </div>

                        <button type="submit" class="btn btn-primary">Xác Nhận</button>
                        <NavLink href="/admin-user" class="btn btn-secondary ms-2">Hủy</NavLink>

                        

                        @if (thongBao != "")
                        {
                            <div class="alert alert-danger">
                                @thongBao
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>


@code {

    private string thongBao = "";
    private AdminAddNewRoleViewModel newRole = new AdminAddNewRoleViewModel();
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        adminService.Onchange += StateHasChanged;
    }

    public async Task addNewRole()
    {
        var result = await adminService.PostRole(newRole);
        if(result)
        {
            thongBao = "Thêm Role thành công";
            newRole = new AdminAddNewRoleViewModel();//reset lại
        }
        else
        {
            thongBao = "Thêm Role thất bại";
        }
    }

    public void Dispose()
    {
        // Cleanup nếu cần
        adminService.Onchange -= StateHasChanged;
    }
}