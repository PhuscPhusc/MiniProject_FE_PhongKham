@page "/add-new-thuoc"

@inject AdminService adminService;

@inject NavigationManager navigationManager;

@implements IDisposable

<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar (chỉ hiện khi màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #0279f8, #0056b3); ">
        <HeaderAdmin />
    </div>

    <!-- Navbar ngang (chỉ hiện khi màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarAdmin />
    </div>

    <!-- Nội dung chính: Edit User -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">✏️ Thêm Thông Tin Thuốc</h2>
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <EditForm Model="@newThuoc" OnValidSubmit="addThuocMoi">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Id</label>
                            <InputNumber class="form-control" @bind-Value="newThuoc.Id" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tên Thuốc</label>
                            <InputText class="form-control" @bind-Value="newThuoc.TenThuoc" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Đơn Vị</label>
                            <InputText class="form-control" @bind-Value="newThuoc.DonVi" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Đơn Giá</label>
                            <InputNumber class="form-control" @bind-Value="newThuoc.DonGia" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mã Danh Mục Thuốc</label>
                            <InputNumber class="form-control" @bind-Value="newThuoc.MaDanhMucThuoc" />
                        </div>
                        

                        <button type="submit" class="btn btn-primary">Thêm Thông Tin Thuốc Mới</button>
                        <NavLink href="/admin-thuoc" class="btn btn-secondary ms-2">Hủy</NavLink>

                        @if (thongBao != "")
                        {
                            <div class="alert alert-danger">
                                @thongBao
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private string thongBao = "";
    private AdminAddNewThuocViewModel newThuoc = new AdminAddNewThuocViewModel();
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        adminService.Onchange += StateHasChanged;
    }

    public async Task addThuocMoi()
    {
        var kq = await adminService.PostThuoc(newThuoc);
        if(kq)
        {
            thongBao = "Thêm thuốc thành công";
            newThuoc = new AdminAddNewThuocViewModel();//reset lại
        }
        else
        {
            thongBao = "Thêm thuốc mới thất bại";
        }
    }

    public void Dispose()
    {
        // Cleanup nếu cần
        adminService.Onchange -= StateHasChanged;
    }
}