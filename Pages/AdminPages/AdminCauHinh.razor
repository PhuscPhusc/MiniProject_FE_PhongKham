@page "/admin-cau-hinh"


<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar (chỉ hiện khi màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #007bff, #0056b3); ">
        <HeaderAdmin />
    </div>

    <!-- Navbar ngang (chỉ hiện khi màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarAdmin />
    </div>

    <!-- Nội dung chính: Cấu hình hệ thống -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">⚙️ Cấu hình hệ thống</h2>
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Giá khám bệnh</dt>
                        <dd class="col-sm-9">50,000 VNĐ</dd>

                        <dt class="col-sm-3">Email hệ thống</dt>
                        <dd class="col-sm-9">clinic@example.com</dd>

                        <dt class="col-sm-3">Ngôn ngữ mặc định</dt>
                        <dd class="col-sm-9">Tiếng Việt</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
