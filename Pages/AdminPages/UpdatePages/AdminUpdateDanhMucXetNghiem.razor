@page "/editDanhMucXetNghiem/{id}"

@inject AdminService adminService;

@inject NavigationManager navigation;


@implements IDisposable


<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar (chỉ hiện khi màn hình lớn) -->
    <div class="text-white p-3 d-none d-md-block"
         style="width:250px; min-height:100vh; background: linear-gradient(180deg, #0279f8, #0056b3); ">
        <HeaderAdmin />
    </div>

    <!-- Navbar ngang (chỉ hiện khi màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarAdmin />
    </div>

    <!-- Nội dung chính: Edit User -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">✏️ Chỉnh sửa thông tin xét nghiệm</h2>
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <EditForm Model="@updateXetNghiem" OnValidSubmit="UpdateXetNghiem">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                       

                        <div class="mb-3">
                            <label class="form-label">Tên Danh Mục</label>
                            <InputText class="form-control" @bind-Value="updateXetNghiem.TenDanhMuc" />
                        </div>

                       

                        <div class="mb-3">
                            <label class="form-label">Giá</label>
                            <InputNumber class="form-control" @bind-Value="updateXetNghiem.Gia" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mã Danh Mục Cha</label>
                            <InputNumber class="form-control" @bind-Value="updateXetNghiem.MaDanhMucCha" />
                        </div>

                       

                        <button type="submit" class="btn btn-primary">Cập nhật xét nghiệm</button>
                        <NavLink href="/admin-xet-nghiem" class="btn btn-secondary ms-2">Hủy</NavLink>

                        @if (thongBao != "")
                        {
                            <div class="alert alert-danger">
                                @thongBao
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>



@code {
    [Parameter]
    public string id { get; set; }
    private string thongBao = "";
    private AdminUpdateDanhMucXetNghiemViewModel updateXetNghiem = new AdminUpdateDanhMucXetNghiemViewModel();

    public async Task UpdateXetNghiem()
    {
        var result = await adminService.UpdateDanhMucXetNghiem(Convert.ToInt32(id), updateXetNghiem);
        thongBao = result ? "Cập nhật thành công" : "Cập nhật thất bại";
    }

    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        adminService.Onchange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if(int.TryParse(id, out int xetNghiemId))
        {
            updateXetNghiem = await adminService.GetDanhMucXetNghiemId(xetNghiemId);
        }
    }

    public void Dispose()
    {
        // Cleanup nếu cần
        adminService.Onchange -= StateHasChanged;
    }
}