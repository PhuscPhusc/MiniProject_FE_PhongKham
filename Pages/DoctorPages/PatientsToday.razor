@page "/doctor-patients-today"

@inject BacSiService bacSiService;

@inject NavigationManager navigationManager;

@implements IDisposable


<div class="d-flex flex-column flex-md-row">
    <!-- Sidebar Doctor (màn hình lớn) -->
    <div class="bg-primary text-white p-3 d-none d-md-block" style="width:250px; min-height:100vh;">
        <HeaderDoctor />
    </div>

    <!-- Navbar Doctor (màn hình nhỏ) -->
    <div class="d-block d-md-none">
        <NavbarDoctor />
    </div>

    <!-- Nội dung chính -->
    <div class="flex-grow-1 p-4" style="background-color:#f8f9fa;">
        <div class="container mt-5">
            <h2 class="text-center mb-4 text-primary fw-bold">📋 Danh sách lịch khám</h2>

            <EditForm Model="new ThongTinBenhNhanTheoMaBacSiViewModel()" OnValidSubmit="HandleValidSearch"
                      class="frm-search input-group mb-3">
                <input type="text" class="form-control" placeholder="Search by Doctor id..." @bind="@id" />
                <NavLink href=@($"/doctor-patients-today?id={id}") class="btn btn-warning" type="submit">Search</NavLink>
            </EditForm>

            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <table class="table table-hover align-middle">
                        <thead class="table-primary text-center">
                            <tr>
                                <th scope="col">Mã lần khám</th>
                                <th scope="col">Mã sổ khám</th>
                                <th scope="col">Mã bệnh nhân</th>
                                <th scope="col">Họ tên bệnh nhân</th>
                                <th scope="col">Ngày khám</th>
                                <th scope="col">Triệu chứng</th>
                                <th scope="col">Kết luận</th>
                                <th scope="col">Ghi chú</th>
                                <th scope="col">Bác sĩ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ThongTinBenhNhanTheoMaBacSiViewModel item in bacSiService._lstBenhNhan)
                            {
                                <tr>
                                    <td class="fw-bold text-center">@item.Id</td>
                                    <td>@item.MaSoKhamBenh</td>
                                    <td>@item.MaBenhNhan</td>
                                    <td>@item.HoTenBenhNhan</td>
                                    <td>@item.NgayKham.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-warning text-dark">@item.TrieuChung</span></td>
                                    <td><span class="badge bg-danger">@item.KetLuan</span></td>
                                    <td>@item.GhiChu</td>
                                    <td><i class="bi bi-person-badge"></i> @item.TenBacSi</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int id { get; set; }

    public async Task HandleValidSearch()
    {
        navigationManager.NavigateTo($"/doctor-patients-today?id={id}");
    }

    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        bacSiService.Onchange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await bacSiService.GetLayThongTinBenhNhanKhamTheoMaBacSi(id);
    }    

    public void Dispose()
    {
        // Cleanup nếu cần
        bacSiService.Onchange -= StateHasChanged;
    }
}